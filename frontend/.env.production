# Frontend production build settings (Next.js).
#
# IMPORTANT — NEXT_PUBLIC_* variables are inlined at BUILD time, not read at
# runtime.  You MUST set this BEFORE `next build` (or your host's build step),
# not just in the running container.
#
# Set this in the Vercel project env settings to your actual backend URL.
# Do NOT hardcode — each deployment environment may differ.
NEXT_PUBLIC_API_URL=https://YOUR_BACKEND_URL_HERE
