# PyroCore Environment Variables
# Copy to .env and modify values as needed
#
# There are TWO ways to run the server, and they read DIFFERENT variable names:
#
#   1. Container / `uvicorn backend.app:app` (see Dockerfile)
#      -> reads the DATABASE_PATH / STORAGE_ROOT / MIGRATIONS_DIR / HOST / PORT
#         variables below, plus the deployment variables further down.
#
#   2. CLI: `pyrocore start`
#      -> reads pyrocore.toml first, then the PYROCORE_* overrides below, then
#         --host/--port/--db-path flags.  `start` normalises all of these into
#         the canonical DATABASE_PATH / STORAGE_ROOT / MIGRATIONS_DIR values
#         above before launching the server, so both paths serve the SAME
#         database.

# --- Canonical (used by the server / routers) ---
DATABASE_PATH=/data/pyrocore.db
STORAGE_ROOT=/data/storage_files
# MIGRATIONS_DIR=/app/backend/migrations
HOST=0.0.0.0
PORT=8000

# --- CLI `start` overrides (optional) ---
# PYROCORE_DB_PATH=/data/pyrocore.db
# PYROCORE_HOST=0.0.0.0
# PYROCORE_PORT=8000

# --- DEPLOYMENT-ONLY ---
# FRONTEND_ORIGIN=https://your-frontend.example.com
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=none
# BACKUP_INTERVAL_SECONDS=300

# --- Rate limits (all read at request time) ---
# AUTH_RATE_LIMIT_PER_MIN=20          # signup + login, per IP
# FORGOT_RATE_LIMIT_PER_HOUR=5        # password reset, per IP and per email
# OAUTH_RATE_LIMIT_PER_MIN=30         # OAuth start + callback, per IP
# SESSION_MAX_AGE_SECONDS=604800      # session cookie lifetime (7 days)
# Comma-separated proxy IPs allowed to set X-Forwarded-For.  Empty = trust
# nobody, which is the safe default.
# TRUSTED_PROXY_IPS=

# --- OAuth sign-in (GitHub / Google) ---
# Both providers are optional. A provider with a blank id or secret reports
# itself as unconfigured and the dashboard greys its button out.
#
# Google: console.cloud.google.com -> APIs & Services -> Credentials
#   Authorized redirect URI: <backend-origin>/auth/oauth/google/callback
# GitHub: github.com/settings/developers -> OAuth Apps -> New OAuth App
#   Authorization callback URL: <backend-origin>/auth/oauth/github/callback
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#
# Backend origin the provider redirects back to. Defaults to the request's own
# origin, which is correct for local dev but must be set explicitly in
# production (Render) because the container sees an internal URL.
# OAUTH_REDIRECT_BASE_URL=https://your-backend.onrender.com
# OAuth state lifetime in seconds (default 600):
# OAUTH_STATE_TTL_SECONDS=600

# --- Password reset (Brevo free tier, ~300 emails/day) ---
# Create an API key at https://app.brevo.com and verify a sender email.
# Without these, reset emails are silently skipped — check the server logs.
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER_EMAIL=noreply@yourdomain.com
# BREVO_SENDER_NAME=PyroCore
# Frontend origin used in the reset link (no trailing slash):
# PASSWORD_RESET_BASE_URL=https://your-dashboard.vercel.app/reset-password
# Token lifetime in seconds (default 3600):
# PASSWORD_RESET_TTL_SECONDS=3600
# Local only: log the full reset URL when Brevo is not configured:
# PASSWORD_RESET_DEV_LOG=true

# --- S3 / object-storage sync (free-tier persistence) ---
# S3_SYNC_ENABLED=true
# S3_BUCKET=my-pyrocore-bucket
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=pyrocore/
